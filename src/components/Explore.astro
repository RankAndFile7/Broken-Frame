---
// Explore — two teaser cards linking to the Why Narrative and Our Story pages.
const cards = [
  {
    href: '/why-narrative',
    eyebrow: 'Why Narrative',
    title: 'Change the story, change the outcome.',
    text: 'Story is the highest leverage point in your business. See how one shift moves everything else with it.',
    cta: 'Explore Why Narrative',
  },
  {
    href: '/our-story',
    eyebrow: 'Our Story',
    title: 'Fifteen years of fixing the wrong thing.',
    text: 'How years of watching businesses throw volume at a broken message led to doing one thing: narrative.',
    cta: 'Read Our Story',
  },
];
---
<section class="explore section" id="explore">
  <div class="container">
    <ul class="explore-grid" role="list">
      {cards.map((c) => (
        <li class="reveal">
          <a class="card" href={c.href}>
            <p class="eyebrow"><span class="frame-mark"></span> {c.eyebrow}</p>
            <h2 class="display card-title">{c.title}</h2>
            <p class="card-text">{c.text}</p>
            <span class="card-cta">{c.cta} <span class="arrow" aria-hidden="true">→</span></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .explore { background: var(--bg-deep); }
  .explore-grid {
    list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(20px, 3.5vw, 48px);
  }
  .card {
    display: flex; flex-direction: column; height: 100%;
    padding: clamp(28px, 3.5vw, 48px);
    border: 1px solid var(--hair-warm); border-radius: 4px;
    background: linear-gradient(180deg, rgba(36,26,51,.35), rgba(21,14,30,.2));
    box-shadow: inset 0 0 60px rgba(245,130,46,.04);
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
  }
  .card:hover {
    transform: translateY(-4px); border-color: rgba(245,130,46,.7);
    box-shadow: inset 0 0 60px rgba(245,130,46,.06), 0 18px 50px rgba(245,130,46,.2);
  }
  .card-title { margin-top: 20px; font-size: clamp(26px, 2.8vw, 38px); line-height: 1.12; }
  .card-text {
    margin-top: 18px; font-weight: 300; font-size: clamp(15px, 1.25vw, 17px);
    line-height: 1.75; color: var(--muted); max-width: 40ch;
  }
  .card-cta {
    margin-top: auto; padding-top: 30px;
    font-size: 14px; font-weight: 600; letter-spacing: .01em; color: var(--ember-hot);
  }
  .card-cta .arrow { display: inline-block; transition: transform .18s ease; }
  .card:hover .card-cta .arrow { transform: translateX(4px); }
  @media (max-width: 760px) { .explore-grid { grid-template-columns: 1fr; } }
</style>
