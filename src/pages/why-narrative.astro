---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Mark from '../components/Mark.astro';
import ContactSection from '../components/ContactSection.astro';

const embers = [
  [12, 4, 'spark', 8, 40, -560, -1], [24, 3, 'ember', 6.5, -30, -560, -3.5], [37, 5, 'spark', 9, 60, -640, -6],
  [49, 4, 'ember', 7.5, -50, -560, -5], [61, 3, 'spark', 6, 50, -560, -4], [73, 5, 'ember', 9.5, 70, -620, -2.8],
  [86, 4, 'spark', 8, 25, -560, -1.7],
] as const;
const upstream = ['Sales', 'Ads', 'Fundraising', 'Team'];
---
<Base
  title="Why Narrative — Broken Frame Strategies"
  description="Story is the highest leverage point in your business. How brand narrative, narrative strategy, and the right metaphor move sales, fundraising, and team at once."
>
  <!-- HERO -->
  <section id="top" class="hero">
    <div class="glow" aria-hidden="true"></div>
    <Nav current="why" />

    <div class="wrap hero-copy">
      <div class="mono spark kicker"><Mark size={16} stroke={3} />Why Narrative</div>
      <h1 class="h-hero">
        <span class="bf" aria-hidden="true" style="--w: 3px; inset: 0 1.1em 0 0">
          <span class="h" style="top: 0; left: 0; right: 0"></span><span class="v" style="top: 0; left: 0; bottom: 0"></span><span class="v" style="right: 0; top: 0; height: 42%"></span><span class="h" style="bottom: 0; left: 0; width: calc(100% - 1.2em)"></span>
          <span class="v brk-load" style="right: 0; top: calc(42% + 0.2em); height: 0.5em; transform: translate(0.66em, 0.1em) rotate(16deg); transform-origin: 50% 0"></span>
          <span class="k brk-load" style="bottom: 0; right: 0; width: 1em; height: 0.62em; border-bottom: var(--w) solid var(--c); border-right: var(--w) solid var(--c); transform: translate(0.72em, 0.42em) rotate(-14deg); transform-origin: 0 0"></span>
        </span>
        <span class="ln">Change the <span class="spark">story,</span></span>
        <span class="ln">change the <span class="spark">outcome.</span></span>
      </h1>
      <p class="intro">Story is the highest leverage point in your business. One shift moves everything else with it.</p>

      <ol class="shift">
        <li>
          <span class="bf" aria-hidden="true" style="--c: rgba(243,234,224,0.7)"><span class="h" style="top: 0; left: 0; right: 0"></span><span class="v" style="top: 0; left: 0; bottom: 0"></span><span class="h" style="bottom: 0; left: 0; right: 0"></span><span class="v" style="top: 0; right: 0; bottom: 0"></span></span>
          <span class="mono step-n">01</span>
          <span class="step">Frame the real problem</span>
        </li>
        <li>
          <span class="bf brk" aria-hidden="true" style="transform: rotate(-3deg) translate(6px, -6px)"><span class="h" style="top: 0; left: 0; right: 0"></span><span class="v" style="top: 0; left: 0; bottom: 0"></span><span class="h" style="bottom: 0; left: 0; right: 0"></span><span class="v" style="top: 0; right: 0; bottom: 0"></span></span>
          <span class="mono step-n">02</span>
          <span class="step">Shift how they see it</span>
        </li>
        <li>
          <span class="bf" aria-hidden="true" style="--c: var(--spark)">
            <span class="v" style="top: 0; left: 0; bottom: 0"></span><span class="h" style="bottom: 0; left: 0; right: 0"></span><span class="h" style="top: 0; left: 0; width: 34%"></span><span class="v" style="right: 0; bottom: 0; height: 34%"></span>
            <span class="h brk" style="top: 0; left: 40%; width: 26%; transform: translate(8px, -22px) rotate(-16deg)"></span>
            <span class="k brk" style="top: 0; right: 0; width: 56px; height: 56px; border-top: var(--w) solid var(--c); border-right: var(--w) solid var(--c); transform: translate(30px, -46px) rotate(28deg); transform-origin: 100% 0"></span>
          </span>
          <span class="mono step-n spark">03</span>
          <span class="step spark">Unlock true buy-in</span>
        </li>
      </ol>
    </div>

    <div class="embers" aria-hidden="true" style="z-index: 2; bottom: -200px; height: 200px">
      {embers.map(([l, s, c, d, x, y, dl]) => (
        <span class="ember" style={`left: ${l}%; width: ${s}px; height: ${s}px; background: var(--${c}); --d: ${d}s; --x: ${x}px; --y: ${y}px; animation-delay: ${dl}s`}></span>
      ))}
    </div>
  </section>

  <!-- BRAND NARRATIVE -->
  <section id="brand-narrative" class="panel-bone bn">
    <div class="wrap pad">
      <div class="mono" style="color: var(--accent); margin-bottom: 40px">Brand Narrative</div>
      <h2 class="h-xl rise" style="max-width: 1150px">The frame you hand people to see your business through.</h2>
      <div class="bn-row">
        <div class="bn-copy">
          <p class="bn-big">Every business is making an argument: the world has a problem, and we're the answer. <span style="color: var(--accent)">Brand narrative is that argument, made airtight.</span></p>
          <p class="bn-small">The point of view that makes your value obvious, your story impossible to forget, and your whole company finally telling the same one.</p>
        </div>
        <figure class="bn-fig">
          <span class="bf" aria-hidden="true" style="--c: var(--accent); --w: 3px; inset: -22px -22px 22px 22px">
            <span class="h" style="top: 0; left: 0; width: calc(100% - 90px)"></span><span class="v" style="top: 0; left: 0; bottom: 0"></span><span class="h" style="bottom: 0; left: 0; right: 0"></span><span class="v" style="right: 0; top: 90px; bottom: 0"></span>
            <span class="k brk" style="top: 0; right: 0; width: 76px; height: 76px; border-top: var(--w) solid var(--c); border-right: var(--w) solid var(--c); transform: translate(20px, -24px) rotate(12deg); transform-origin: 100% 0"></span>
          </span>
          <img src="/images/frame-bonfire.jpg" alt="Old picture frames burning in a beach bonfire at sunset" loading="lazy" decoding="async" />
        </figure>
      </div>
      <ul class="bn-points">
        <li>
          <Mark size={34} stroke={2} color="var(--accent)" />
          <p><strong>Condensed meaning</strong> — everything your company believes, stands for, and is going after, captured in one clear frame</p>
        </li>
        <li>
          <svg width="34" height="34" viewBox="0 0 26 26" fill="none" aria-hidden="true"><path d="M3 3h20v20H3z" stroke="var(--accent)" stroke-width="2"></path><path d="M9 13h8M13 9v8" stroke="var(--accent)" stroke-width="2"></path></svg>
          <p>When people get it, they don't just understand what you do — they start seeing it your way.</p>
        </li>
        <li>
          <svg width="34" height="34" viewBox="0 0 26 26" fill="none" aria-hidden="true"><path d="M13 23V9M13 9l-5 5M13 9l5 5M5 3h16" stroke="var(--accent)" stroke-width="2"></path></svg>
          <p>Turns your story into something that spreads on its own.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- NARRATIVE STRATEGY -->
  <section id="strategy" class="wrap strat">
    <div class="mono spark" style="margin-bottom: 40px">Narrative Strategy</div>
    <div class="mirror" aria-hidden="true">
      <span class="rise" style="text-align: right">Story</span>
      <span class="mirror-mid mono">
        <span class="drawx bar"></span>
        <span>who you serve</span><span>why you win</span><span>how you work</span>
        <span class="drawx bar"></span>
      </span>
      <span class="rise outline">Strategy</span>
    </div>
    <div class="strat-row">
      <p class="strat-big">Your story and your strategy are the same choices in two different languages. Crafting your narrative forces the choices that define your business — who you serve, why you win, how you work.</p>
      <p class="strat-small">That's why narrative work goes deeper than words: <span class="ember-text" style="font-weight: 600">when we sharpen your story, we're really sharpening your strategy.</span></p>
    </div>
  </section>

  <!-- CORE STORIES -->
  <section id="core-stories" class="panel-red core">
    <div class="wrap pad-red">
      <h2 class="h-xl rise">The core stories that <span class="spark">give you leverage.</span></h2>
      <div class="core-grid">
        <div class="core-card">
          <span class="bf" aria-hidden="true" style="--c: var(--bone)">
            <span class="h" style="top: 0; left: 0; width: calc(100% - 72px)"></span><span class="v" style="top: 0; left: 0; bottom: 0"></span><span class="h" style="bottom: 0; left: 0; right: 0"></span><span class="v" style="right: 0; top: 72px; bottom: 0"></span>
            <span class="k brk" style="top: 0; right: 0; width: 58px; height: 58px; border-top: var(--w) solid var(--c); border-right: var(--w) solid var(--c); transform: translate(14px, -16px) rotate(10deg); transform-origin: 100% 0"></span>
          </span>
          <h3>Founder Story</h3><p>Get people to believe in you.</p>
        </div>
        <div class="core-card">
          <span class="bf" aria-hidden="true" style="--c: var(--bone)">
            <span class="h" style="top: 0; left: 0; right: 0"></span><span class="v" style="top: 0; right: 0; bottom: 0"></span><span class="v" style="top: 0; left: 0; bottom: 72px"></span><span class="h" style="bottom: 0; left: 72px; right: 0"></span>
            <span class="k brk" style="bottom: 0; left: 0; width: 58px; height: 58px; border-bottom: var(--w) solid var(--c); border-left: var(--w) solid var(--c); transform: translate(-14px, 18px) rotate(10deg); transform-origin: 0 100%"></span>
          </span>
          <h3>Purpose Story</h3><p>Inspire customers and align your team.</p>
        </div>
        <div class="core-card">
          <span class="bf" aria-hidden="true" style="--c: var(--bone)">
            <span class="half" style="clip-path: inset(-40px 51% -40px -40px)"><span class="h" style="top: 0; left: 0; right: 0"></span><span class="v" style="top: 0; left: 0; bottom: 0"></span><span class="h" style="bottom: 0; left: 0; right: 0"></span><span class="v" style="top: 0; right: 0; bottom: 0"></span></span>
            <span class="half brk" style="clip-path: inset(-40px -40px -40px 51%); transform: translate(14px, -12px) rotate(3deg)"><span class="h" style="top: 0; left: 0; right: 0"></span><span class="v" style="top: 0; left: 0; bottom: 0"></span><span class="h" style="bottom: 0; left: 0; right: 0"></span><span class="v" style="top: 0; right: 0; bottom: 0"></span></span>
          </span>
          <h3>Value Story</h3><p>Make people emotionally understand your offering.</p>
        </div>
        <div class="core-card">
          <span class="bf" aria-hidden="true" style="--c: var(--bone)">
            <span class="h" style="top: 0; right: 0; left: 72px"></span><span class="v" style="left: 0; top: 72px; bottom: 0"></span><span class="h" style="bottom: 0; left: 0; right: 0"></span><span class="v" style="top: 0; right: 0; bottom: 0"></span>
            <span class="k brk" style="top: 0; left: 0; width: 58px; height: 58px; border-top: var(--w) solid var(--c); border-left: var(--w) solid var(--c); transform: translate(-16px, -16px) rotate(-10deg); transform-origin: 0 0"></span>
          </span>
          <h3>Customer Story</h3><p>Establish credibility and showcase impact.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- METAPHORS -->
  <section id="metaphors" class="wrap meta">
    <div class="meta-copy">
      <h2 class="h-xl rise">The magic of <span class="ember-text">metaphors.</span></h2>
      <p class="meta-big">Explaining complicated products is a big challenge. But with the right metaphor, you can copy an entire branch of knowledge from a familiar concept and paste it right onto your solution.</p>
      <p class="meta-small">Suddenly, what once required paragraphs of explanation clicks in your audience's mind faster than you can press Ctrl+C, Ctrl+V.</p>
    </div>
    <div class="keys mono" aria-hidden="true">
      <div class="rise keyrow">
        <span class="key wide">Ctrl</span><span class="plus">+</span><span class="key">C</span>
        <span class="keynote">familiar concept</span>
      </div>
      <div class="drawy keylink"></div>
      <div class="rise keyrow hot">
        <span class="key wide">Ctrl</span><span class="plus">+</span><span class="key">V</span>
        <span class="keynote">your solution</span>
      </div>
    </div>
  </section>

  <!-- NEW HAT -->
  <section id="new-hat" class="wrap hat">
    <div class="hat-frame">
      <span class="bf" aria-hidden="true" style="--w: 3px">
        <span class="h" style="top: 0; left: 0; right: 0"></span><span class="v" style="top: 0; right: 0; bottom: 0"></span><span class="v" style="top: 0; left: 0; height: 52%"></span>
        <span class="v brk" style="top: calc(52% + 22px); left: 0; bottom: 0; transform: translateX(-18px)"></span>
        <span class="h brk" style="bottom: 0; left: 0; width: calc(100% + 18px); transform: translateX(-18px)"></span>
      </span>
      <h2 class="h-xl rise" style="line-height: 0.98">
        <span style="display: block">Your new hat:</span>
        <span class="spark" style="display: block">Chief Storytelling Officer</span>
      </h2>
      <div class="hat-row">
        <p>Narrative is the foundation your entire company runs on — and it's the one job you can never hand off. But most founders don't take their ownership of the narrative as seriously as they should.</p>
        <div>
          <p>I not only build it with you, but teach you to own it. The goal isn't to make you dependent on me.</p>
          <p class="rise hat-punch">It's to make you dangerous without me.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ROI -->
  <section id="roi" class="panel-bone roi">
    <div class="wrap pad-roi">
      <div class="px-slow ghost roi-ghost" aria-hidden="true">ROI</div>
      <h2 class="rise roi-title">Unmatched <span style="color: var(--accent)">ROI</span></h2>
      <div class="tree" aria-hidden="true">
        <div class="root">Narrative
          <span class="bf" style="--c: var(--ink); --w: 2px; inset: -12px">
            <span class="h" style="top: 0; left: 0; width: calc(100% - 40px)"></span><span class="v" style="top: 0; left: 0; bottom: 0"></span><span class="h" style="bottom: 0; left: 0; right: 0"></span><span class="v" style="right: 0; top: 40px; bottom: 0"></span>
            <span class="k brk" style="top: 0; right: 0; width: 30px; height: 30px; border-top: var(--w) solid var(--c); border-right: var(--w) solid var(--c); transform: translate(10px, -12px) rotate(14deg); transform-origin: 100% 0"></span>
          </span>
        </div>
        <div class="drawy stem"></div>
        <div class="drawx crossbar"></div>
        <div class="leaves">
          {upstream.map((u) => (
            <div class="leaf"><span class="drawy twig"></span><span class="leaf-label">{u}</span></div>
          ))}
        </div>
      </div>
      <p class="roi-copy">Narrative sits upstream of everything in your business. Your sales, your ads, your fundraising, your team — they all flow from it. Which means improving it improves everything at once. <strong style="color: var(--accent)">No other investment in your business has that kind of reach.</strong></p>
    </div>
  </section>

  <ContactSection />
</Base>

<style>
  .hero { position: relative; }
  .glow {
    position: absolute; left: 50%; bottom: -240px; width: 1400px; height: 700px; transform: translateX(-50%); pointer-events: none;
    background: radial-gradient(closest-side, rgba(242,107,29,0.22), rgba(158,27,20,0.12) 55%, rgba(14,11,12,0) 100%);
  }
  .hero-copy { z-index: 3; padding-top: 110px; padding-bottom: 200px; }
  .kicker { display: flex; align-items: center; gap: 14px; margin-bottom: 44px; }
  .intro { margin: 48px 0 0; max-width: 560px; font-size: 22px; line-height: 1.45; color: rgba(243,234,224,0.92); }
  .shift { list-style: none; margin: 110px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 56px 48px; }
  .shift li { position: relative; padding: 40px 36px 44px; min-height: 180px; display: flex; flex-direction: column; justify-content: space-between; gap: 24px; }
  .step-n { color: var(--ember); }
  .step { font-weight: 700; font-stretch: 82%; font-size: 30px; line-height: 1.05; letter-spacing: -0.015em; }

  .pad { padding-top: 200px; padding-bottom: 200px; }
  .bn { clip-path: polygon(0 52px, 22% 8px, 23.5% 44px, 55% 0, 57% 34px, 82% 18px, 100% 60px, 100% 100%, 0 100%); }
  .bn-row { display: flex; flex-wrap: wrap; gap: 72px 80px; margin-top: 88px; align-items: center; }
  .bn-copy { flex: 1 1 520px; display: flex; flex-direction: column; gap: 28px; }
  .bn-big { margin: 0; font-size: 30px; line-height: 1.3; font-weight: 600; font-stretch: 90%; letter-spacing: -0.01em; }
  .bn-small { margin: 0; font-size: 20px; line-height: 1.55; }
  .bn-fig { position: relative; margin: 0; flex: 0 1 400px; }
  .bn-fig img { position: relative; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; object-position: 52% 60%; }
  .bn-points { list-style: none; margin: 104px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 48px; }
  .bn-points li { border-top: 3px solid var(--ink); padding-top: 28px; display: flex; flex-direction: column; gap: 18px; }
  .bn-points p { margin: 0; font-size: 20px; line-height: 1.5; }

  .strat { padding-top: 180px; padding-bottom: 180px; }
  .mirror {
    display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 32px;
    font-weight: 800; font-stretch: 68%; font-size: clamp(48px, 10vw, 168px); line-height: 0.9; letter-spacing: -0.03em;
  }
  .mirror-mid { display: flex; flex-direction: column; gap: 14px; align-items: stretch; font-weight: 400; letter-spacing: 0.06em; line-height: 1.2; color: var(--ember); text-align: center; }
  .bar { display: block; height: 2px; background: var(--line); }
  .outline { color: transparent; -webkit-text-stroke: 2px var(--bone); }
  .strat-row { display: flex; flex-wrap: wrap; gap: 40px 72px; margin-top: 96px; }
  .strat-big { margin: 0; flex: 1 1 480px; font-size: 26px; line-height: 1.4; font-weight: 500; }
  .strat-small { margin: 0; flex: 1 1 420px; font-size: 20px; line-height: 1.55; color: rgba(243,234,224,0.86); }

  .core { clip-path: polygon(0 34px, 31% 0, 32.5% 44px, 64% 12px, 66% 56px, 100% 6px, 100% calc(100% - 44px), 72% 100%, 70.5% calc(100% - 34px), 38% calc(100% - 8px), 0 calc(100% - 56px)); }
  .pad-red { padding-top: 200px; padding-bottom: 230px; }
  .core-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 64px 40px; margin-top: 104px; }
  .core-card { position: relative; padding: 40px 32px 44px; min-height: 230px; display: flex; flex-direction: column; justify-content: space-between; gap: 32px; }
  .core-card h3 { margin: 0; font-weight: 800; font-stretch: 72%; font-size: 44px; line-height: 0.95; letter-spacing: -0.02em; }
  .core-card p { margin: 0; font-size: 19px; line-height: 1.45; }

  .meta { padding-top: 180px; padding-bottom: 160px; display: flex; flex-wrap: wrap; gap: 72px 80px; align-items: center; }
  .meta-copy { flex: 1 1 520px; }
  .meta-big { margin: 48px 0 0; font-size: 22px; line-height: 1.5; }
  .meta-small { margin: 24px 0 0; font-size: 20px; line-height: 1.55; color: rgba(243,234,224,0.86); }
  .keys { flex: 0 1 460px; display: flex; flex-direction: column; gap: 28px; }
  .keyrow { display: flex; align-items: center; gap: 14px; }
  .key {
    display: inline-flex; align-items: center; justify-content: center; width: 96px; height: 96px;
    border: 2px solid var(--bone); border-radius: 14px; box-shadow: 0 8px 0 rgba(243,234,224,0.35); font-size: 30px;
  }
  .key.wide { width: auto; min-width: 120px; padding: 0 20px; font-size: 26px; }
  .plus { font-size: 26px; color: rgba(243,234,224,0.6); }
  .keynote { font-size: 13px; letter-spacing: 0.06em; color: rgba(243,234,224,0.75); margin-left: 8px; }
  .hot .key { border-color: var(--spark); box-shadow: 0 8px 0 var(--ember); color: var(--spark); }
  .hot .keynote { color: var(--spark); }
  .keylink { width: 2px; height: 56px; margin-left: 58px; background: var(--line); }

  .hat { padding-top: 120px; padding-bottom: 160px; }
  .hat-frame { position: relative; padding: 72px 64px 80px; }
  .hat-row { display: flex; flex-wrap: wrap; gap: 32px 72px; margin-top: 64px; }
  .hat-row > p, .hat-row > div { flex: 1 1 420px; }
  .hat-row p { margin: 0; font-size: 21px; line-height: 1.55; color: rgba(243,234,224,0.9); }
  .hat-row .hat-punch { margin-top: 24px; font-weight: 800; font-stretch: 74%; font-size: 48px; line-height: 0.98; letter-spacing: -0.02em; color: var(--spark); }

  .roi { clip-path: polygon(0 40px, 18% 0, 19.5% 38px, 52% 10px, 54% 46px, 84% 4px, 100% 36px, 100% 100%, 0 100%); }
  .pad-roi { padding-top: 190px; padding-bottom: 190px; }
  .roi-ghost { top: 70px; font-size: clamp(200px, 30vw, 460px); -webkit-text-stroke-color: rgba(14,11,12,0.08); }
  .roi-title { position: relative; margin: 0; font-weight: 800; font-stretch: 72%; font-size: clamp(56px, 9vw, 150px); line-height: 0.9; letter-spacing: -0.03em; }
  .tree { position: relative; margin: 96px auto 0; max-width: 980px; display: flex; flex-direction: column; align-items: center; }
  .root { position: relative; padding: 26px 56px; font-weight: 800; font-stretch: 72%; font-size: 48px; line-height: 1; letter-spacing: -0.02em; color: var(--bone); background: var(--accent); }
  .stem { width: 2px; height: 56px; background: var(--ink); }
  .crossbar { width: 75%; height: 2px; background: var(--ink); }
  .leaves { width: 100%; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); text-align: center; }
  .leaf { display: flex; flex-direction: column; align-items: center; }
  .twig { display: block; width: 2px; height: 48px; background: var(--ink); }
  .leaf-label { margin-top: 14px; padding: 14px 4px; border-top: 3px solid var(--accent); font-weight: 700; font-stretch: 82%; font-size: clamp(16px, 2.2vw, 28px); }
  .roi-copy { position: relative; margin: 88px auto 0; max-width: 820px; text-align: center; font-size: 24px; line-height: 1.5; }

  @media (max-width: 700px) {
    .hero-copy { padding-top: 56px; padding-bottom: 130px; }
    .kicker { margin-bottom: 28px; }
    .intro { font-size: 19px; }
    .shift { margin-top: 64px; gap: 40px; }
    .shift li { min-height: 140px; padding: 28px 24px 30px; }
    .step { font-size: 26px; }
    .pad, .pad-red, .pad-roi { padding-top: 130px; padding-bottom: 140px; }
