---
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer-inner">
    <a class="brand" href="#top" aria-label="Broken Frame Strategies — top">
      <span class="logo-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="22" height="22">
          <path d="M8 7 H21 M8 7 V20" fill="none" stroke="var(--ember)" stroke-width="2.2" stroke-linecap="square"/>
          <path d="M24 25 H11 M24 25 V12" fill="none" stroke="var(--ember)" stroke-width="2.2" stroke-linecap="square"/>
        </svg>
      </span>
      <span class="brand-name">Broken Frame Strategies</span>
    </a>

    <nav class="footer-links" aria-label="Footer">
      <a href="#problem">Problem</a>
      <a href="#approach">Approach</a>
      <a href="#payoff">What It Unlocks</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
    </nav>

    <p class="footer-meta">Encinitas, CA · © {year}</p>
  </div>
</footer>

<style>
  .footer { background: var(--bg-deep); border-top: 1px solid var(--hair); padding-block: 40px; }
  .footer-inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .brand { display: inline-flex; align-items: center; gap: 10px; }
  .logo-mark { display: grid; place-items: center; }
  .brand-name { font-family: var(--sans); font-weight: 600; font-size: 12px; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }
  .footer-links { display: flex; gap: 24px; flex-wrap: wrap; }
  .footer-links a { font-size: 13.5px; color: var(--muted); transition: color .2s ease; }
  .footer-links a:hover { color: var(--ink); }
  .footer-meta { font-size: 13px; color: var(--muted-dim); }
  @media (max-width: 640px) { .footer-inner { flex-direction: column; align-items: flex-start; } }
</style>
