---
import Mark from './Mark.astro';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap inner">
    <div class="name"><Mark size={22} /> Broken Frame Strategies</div>
    <nav aria-label="Footer" class="links">
      <a href="/">Home</a>
      <a href="/why-narrative/">Why Narrative</a>
      <a href="/our-story/">Our Story</a>
      <a href="/free-consultation/">Free Consultation</a>
    </nav>
    <div class="meta">Encinitas, CA · © {year}</div>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid rgba(243,234,224,0.18); }
  .inner {
    padding-block: 40px;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px;
  }
  .name {
    display: inline-flex; align-items: center; gap: 12px;
    font-weight: 800; font-stretch: 78%; font-size: 22px; letter-spacing: -0.01em;
  }
  .links, .meta { font-family: var(--mono); font-size: 13px; letter-spacing: 0.04em; }
  .links { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .links a { text-decoration: none; padding-block: 10px; }
  .meta { color: rgba(243,234,224,0.72); }
</style>
