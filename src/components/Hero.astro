---
// Hero — framed sunset gradient panel, scattered broken-frame shards, sparks.
---
<section class="hero" id="top">
  <!-- warm glow pooling at the base of the hero -->
  <div class="hero-glow" aria-hidden="true"></div>

  <!-- floating broken-frame shards -->
  <div class="shards" aria-hidden="true">
    <span class="shard s1"></span>
    <span class="shard s2"></span>
    <span class="shard s3"></span>
    <span class="shard s4"></span>
    <span class="spark p1"></span>
    <span class="spark p2"></span>
    <span class="spark p3"></span>
  </div>

  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow reveal"><span class="frame-mark"></span> Brand Narrative Consulting</p>

      <div class="headline-frame reveal">
        <h1 class="display hero-title">Ignite your<br />brand <em>story.</em></h1>
      </div>

      <p class="hero-sub reveal">
        Brand narrative consulting that gives founders outsized leverage to fuel growth.
      </p>

      <a class="btn hero-btn reveal" href="#contact">
        Book a free consultation
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <!-- framed sunset panel -->
    <div class="hero-visual reveal" aria-hidden="true">
      <div class="panel-frame">
        <div class="panel-gradient"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative; overflow: hidden;
    padding-top: clamp(140px, 18vh, 210px);
    padding-bottom: clamp(80px, 12vh, 150px);
    min-height: 100svh; display: flex; align-items: center;
  }
  .hero-glow {
    position: absolute; left: 50%; bottom: -30%; transform: translateX(-50%);
    width: 120%; height: 80%;
    background: radial-gradient(ellipse 46% 60% at 60% 50%,
      rgba(216,72,28,.30), rgba(120,40,80,.18) 42%, transparent 72%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative; z-index: 3;
    display: grid; grid-template-columns: 1.18fr .82fr; gap: clamp(30px, 5vw, 76px);
    align-items: center; width: 100%;
  }

  .hero-title { font-size: clamp(46px, 5.6vw, 82px); margin-top: 4px; max-width: none; white-space: nowrap; }

  /* thin frame around the headline, with a broken top-right corner */
  .headline-frame {
    position: relative; display: inline-block;
    margin: 28px 0 4px; padding: 30px 46px 30px 34px;
    border: 1px solid var(--hair);
  }
  .headline-frame::after {
    /* the break: a notch of background over the top-right corner */
    content: ''; position: absolute; top: -1px; right: 22%; width: 26%; height: 3px;
    background: var(--bg); pointer-events: none;
  }

  .hero-sub {
    margin-top: 30px; max-width: 42ch;
    font-weight: 300; font-size: clamp(16px, 1.4vw, 18px); line-height: 1.7; color: var(--muted);
  }
  .hero-btn { margin-top: 38px; }

  /* framed sunset panel */
  .hero-visual { justify-self: end; width: 100%; max-width: 400px; }
  .panel-frame {
    position: relative; padding: 14px; border: 1px solid var(--hair-warm); border-radius: 4px;
    box-shadow: 0 0 0 1px rgba(245,130,46,.08), 0 30px 90px rgba(216,72,28,.22);
  }
  .panel-frame::before {
    /* offset ghost frame — the 'broken' second frame */
    content: ''; position: absolute; inset: -22px -22px auto auto; width: 78%; height: 78%;
    border: 1px solid var(--hair); border-radius: 4px; pointer-events: none;
  }
  .panel-gradient {
    aspect-ratio: 4 / 4.3; border-radius: 2px;
    background: linear-gradient(178deg,
      #3B2E78 0%, #55357E 20%, #8A3F84 42%, #B94E6E 58%,
      #E0703A 74%, #F59A3E 88%, #FFC366 100%);
    box-shadow: inset 0 0 60px rgba(0,0,0,.28), 0 0 50px rgba(245,130,46,.28);
    position: relative; overflow: hidden;
  }
  .panel-gradient::after {
    /* subtle scanline texture */
    content: ''; position: absolute; inset: 0;
    background: repeating-linear-gradient(180deg, rgba(0,0,0,.10) 0 2px, transparent 2px 5px);
    opacity: .35;
  }

  /* shards */
  .shards { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  .shard { position: absolute; border: 1px solid var(--hair); border-radius: 3px; }
  .s1 { width: 150px; height: 110px; right: 30%; top: 22%; transform: rotate(-14deg); border-color: var(--hair-warm); opacity: .5; }
  .s2 { width: 120px; height: 150px; left: 4%; bottom: 16%; transform: rotate(11deg); opacity: .35; }
  .s3 { width: 90px;  height: 70px;  right: 7%; bottom: 12%; transform: rotate(-8deg); opacity: .3; }
  .s4 { width: 70px;  height: 90px;  right: 46%; top: 8%;  transform: rotate(18deg); opacity: .25; }
  .p1 { width: 4px; height: 4px; right: 24%; top: 14%; }
  .p2 { width: 3px; height: 3px; right: 12%; top: 30%; opacity: .5; }
  .p3 { width: 5px; height: 5px; left: 30%; bottom: 24%; opacity: .45; }

  @media (max-width: 900px) {
    .hero { min-height: auto; }
    .hero-inner { grid-template-columns: 1fr; }
    .hero-visual { order: -1; max-width: 320px; justify-self: start; margin-bottom: 8px; }
    .panel-frame::before { display: none; }
    .s1, .s4 { display: none; }
  }
</style>
