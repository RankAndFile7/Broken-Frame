---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';

const tags = ['Frame the real problem', 'Shift how they see it', 'Unlock true buy-in'];

const svg = (inner: string) =>
  `<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${inner}</svg>`;
const icons: Record<string, string> = {
  sparkle: svg('<path d="M12 3c.6 4.6 2.4 6.4 7 7-4.6.6-6.4 2.4-7 7-.6-4.6-2.4-6.4-7-7 4.6-.6 6.4-2.4 7-7z"/><path d="M19 3v3M17.5 4.5h3"/>'),
  eye: svg('<path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12z"/><circle cx="12" cy="12" r="3" fill="currentColor"/>'),
  yinyang: svg('<circle cx="12" cy="12" r="9"/><path d="M12 3a4.5 4.5 0 0 1 0 9 4.5 4.5 0 0 0 0 9"/><circle cx="12" cy="7.5" r="1" fill="currentColor"/><circle cx="12" cy="16.5" r="1" fill="currentColor"/>'),
  umbrella: svg('<path d="M3 12a9 9 0 0 1 18 0H3z" fill="currentColor"/><path d="M12 12v6a2 2 0 0 0 4 0"/><path d="M12 3v1"/>'),
  chat: svg('<path d="M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1h-8l-5 4v-4H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z" fill="currentColor"/>'),
};

const stories = [
  { title: 'Founder Story', note: 'Get people to believe in you.' },
  { title: 'Purpose Story', note: 'Inspire customers and align your team.' },
  { title: 'Value Story', note: 'Make people emotionally understand your offering.' },
  { title: 'Customer Story', note: 'Establish credibility and showcase impact.' },
];

const points = [
  { icon: 'sparkle', text: "Every business is making an argument: the world has a problem, and we're the answer. Brand narrative is that argument, made airtight." },
  { icon: 'eye', text: 'The point of view that makes your value obvious, your story impossible to forget, and your whole company finally telling the same one.' },
  { icon: 'yinyang', text: 'Condensed meaning — everything your company believes, stands for, and is going after, captured in one clear frame' },
  { icon: 'umbrella', text: "When people get it, they don't just understand what you do — they start seeing it your way." },
  { icon: 'chat', text: 'Turns your story into something that spreads on its own.' },
];
---
<Base title="Why Narrative — Broken Frame Strategies" description="Story is the highest leverage point in your business. One shift moves everything else with it.">
  <Nav />
  <main>
    <section class="wn-hero" id="top">
      <div class="container wn-inner">
        <h1 class="display wn-title reveal">
          Change The <em>Story,</em><br />
          Change The <em>Outcome</em>
        </h1>
        <p class="wn-sub reveal">
          Story is the highest leverage point in your business. One shift moves everything else with it.
        </p>
        <ul class="wn-tags reveal" role="list">
          {tags.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    </section>

    <section class="bn section" id="brand-narrative">
      <div class="container">
        <div class="bn-head">
          <h2 class="display bn-title reveal">Brand Narrative</h2>
          <p class="bn-sub reveal">The frame you hand people to see your business through.</p>
        </div>

        <div class="bn-grid">
          <ul class="bn-list" role="list">
            {points.map((p) => (
              <li class="reveal">
                <span class="bn-icon" aria-hidden="true" set:html={icons[p.icon]} />
                <span>{p.text}</span>
              </li>
            ))}
          </ul>

          <div class="bn-photo reveal">
            <img src="/frame-photo.png" alt="A hand holding up an empty picture frame against a coastal landscape, with a hang glider visible through it" />
          </div>
        </div>
      </div>
    </section>

    <section class="ns section" id="narrative-strategy">
      <div class="container">
        <h2 class="display ns-title reveal">Narrative Strategy</h2>
        <div class="ns-body reveal">
          <p>
            Your story and your strategy are the same choices in two different languages. Crafting your
            narrative forces the choices that define your business — who you serve, why you win, how you work.
          </p>
          <p>
            That's why narrative work goes deeper than words: when we sharpen your story, we're really
            sharpening your strategy.
          </p>
        </div>
      </div>
    </section>

    <section class="cs section" id="core-stories">
      <div class="container">
        <h2 class="display cs-title reveal">
          The Core Stories That<br />
          Give You <em>Leverage</em>
        </h2>
        <ul class="cs-grid" role="list">
          {stories.map((s) => (
            <li class="cs-card reveal">
              <h3>{s.title}</h3>
              <p>{s.note}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="mm section" id="metaphors">
      <div class="container">
        <h2 class="display mm-title reveal">The Magic Of Metaphors</h2>
        <div class="mm-body reveal">
          <p>
            Explaining complicated products is a big challenge. But with the right metaphor, you can copy an
            entire branch of knowledge from a familiar concept and paste it right onto your solution.
          </p>
          <p>
            Suddenly, what once required paragraphs of explanation clicks in your audience's mind faster than
            you can press Ctrl+C, Ctrl+V.
          </p>
        </div>
      </div>
    </section>

    <section class="mm hat section" id="new-hat">
      <div class="container">
        <h2 class="display mm-title reveal">
          Your New Hat:<br />
          Chief Storytelling Officer
        </h2>
        <div class="mm-body reveal">
          <p>
            Narrative is the foundation your entire company runs on — and it's the one job you can never hand
            off. But most founders take their ownership of the narrative as seriously as they should.
          </p>
          <p>
            I not only build it with you, but teach you to own it. The goal isn't to make you dependent on me.
            It's to make you dangerous without me.
          </p>
        </div>
      </div>
    </section>

    <section class="roi section" id="roi">
      <div class="container roi-grid">
        <div class="mm-body reveal">
          <p>
            Narrative sits upstream of everything in your business. Your sales, your ads, your fundraising,
            your team — they all flow from it. Which means improving it improves everything at once. No other
            investment in your business has that kind of reach.
          </p>
        </div>
        <h2 class="display roi-title reveal">Unmatched ROI</h2>
      </div>
    </section>

    <Contact />
  </main>
  <Footer />
</Base>

<style>
  .wn-hero {
    position: relative;
    padding-top: clamp(140px, 20vh, 220px);
    padding-bottom: clamp(80px, 12vh, 150px);
    min-height: 80svh; display: flex; align-items: center;
  }
  .wn-inner { width: 100%; }
  .wn-title { font-size: clamp(40px, 6vw, 80px); line-height: 1.02; }
  .wn-sub {
    margin-top: 26px; max-width: 28ch;
    font-weight: 300; font-size: clamp(22px, 2.4vw, 32px); line-height: 1.45; color: var(--muted);
  }
  .bn { background: var(--bg-deep); }
  .bn-head { text-align: center; }
  .bn-title { font-size: clamp(34px, 4.6vw, 60px); }
  .bn-sub {
    margin-top: 16px; font-weight: 300; color: var(--muted);
    font-size: clamp(18px, 2vw, 26px); line-height: 1.4;
  }
  .bn-grid {
    margin-top: clamp(48px, 6vw, 84px);
    display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(30px, 6vw, 90px); align-items: center;
  }
  .bn-list { list-style: none; display: flex; flex-direction: column; gap: 28px; }
  .bn-list li {
    display: flex; gap: 16px; align-items: flex-start;
    font-weight: 300; font-size: clamp(15px, 1.3vw, 17px); line-height: 1.7; color: var(--ink);
  }
  .bn-icon { flex: none; color: var(--ember); margin-top: 2px; display: grid; place-items: center; }
  .bn-photo img {
    width: 100%; max-width: 400px; margin-left: auto; aspect-ratio: 1 / 1; object-fit: cover;
    border-radius: 14px; border: 1px solid var(--hair-warm); box-shadow: 0 24px 70px rgba(0,0,0,.45);
  }
  @media (max-width: 860px) {
    .bn-grid { grid-template-columns: 1fr; }
    .bn-photo img { margin-left: 0; max-width: 340px; }
  }
  .ns { background: var(--bg); }
  .ns-title { font-size: clamp(38px, 5.6vw, 76px); }
  .ns-body {
    margin-top: clamp(36px, 5vw, 64px); max-width: 62ch;
    padding-left: 22px; border-left: 2px solid var(--ember);
  }
  .ns-body p {
    font-weight: 300; font-size: clamp(16px, 1.45vw, 19px); line-height: 1.75; color: var(--ink);
  }
  .ns-body p + p { margin-top: 18px; }
  .cs { background: var(--bg-deep); }
  .cs-title { text-align: center; font-size: clamp(32px, 4.8vw, 64px); line-height: 1.08; }
  .cs-grid {
    list-style: none; max-width: 940px; margin: clamp(44px, 6vw, 80px) auto 0;
    display: grid; grid-template-columns: 1fr 1fr; gap: clamp(20px, 3.5vw, 48px);
  }
  .cs-card {
    padding: clamp(26px, 3vw, 36px); min-height: 140px;
    background: rgba(8,5,13,.55); border: 1px solid var(--hair); border-top: 3px solid var(--ember);
    border-radius: 10px;
    transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
  }
  .cs-card:hover { transform: translateY(-3px); border-color: var(--hair-warm); box-shadow: 0 14px 40px rgba(245,130,46,.14); }
  .cs-card h3 { font-family: var(--serif); font-weight: 600; font-size: clamp(20px, 1.9vw, 25px); color: var(--ink); letter-spacing: -.01em; }
  .cs-card p { margin-top: 12px; font-weight: 300; font-size: 15px; line-height: 1.6; color: var(--muted); }
  @media (max-width: 720px) { .cs-grid { grid-template-columns: 1fr; } }
  .mm { background: var(--bg); }
  .mm-title { font-size: clamp(34px, 5vw, 66px); }
  .mm-body {
    margin-top: clamp(32px, 4vw, 52px); max-width: 880px;
    padding: 6px clamp(20px, 3vw, 36px);
    border-left: 2px solid var(--ember); border-right: 2px solid var(--ember);
  }
  .mm-body p { font-weight: 300; font-size: clamp(16px, 1.5vw, 20px); line-height: 1.8; color: var(--ink); }
  .mm-body p + p { margin-top: 26px; }
  .hat { background: var(--bg-deep); }
  .roi { background: var(--bg); }
  .roi-grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(30px, 5vw, 70px); align-items: start; }
  .roi .mm-body { margin-top: 0; max-width: none; }
  .roi-title { font-size: clamp(34px, 5vw, 66px); }
  @media (max-width: 860px) {
    .roi-grid { grid-template-columns: 1fr; }
    .roi-title { order: -1; }
  }
  .wn-tags { margin-top: 38px; display: flex; flex-wrap: wrap; gap: 10px; list-style: none; }
  .wn-tags li {
    padding: 8px 14px; border-radius: 6px; background: rgba(244,239,231,.07);
    font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--ink);
  }
</style>
